{
  "name": "fixplor",
  "private": true,
  "version": "0.1.19",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && npm run check --workspaces",
    "test": "vitest run && npm test --workspaces",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon src-tauri/icons/icon-manifest.json",
    "build:plugin": "vite build -c plugins/fixplor/vite.config.ts && node plugins/fixplor/scripts/pack.mjs",
    "check:plugin": "node plugins/fixplor/scripts/check-boundary.mjs",
    "check:host": "node plugins/fixplor/scripts/host-check.mjs"
  },
  "dependencies": {
    "@3pino/app-kit-web": "git+https://github.com/3pino/app-kit-web.git#v0.6.2",
    "@3pino/design-system": "git+https://github.com/3pino/design-system.git#v0.4.1",
    "@3pino/explorer-kit": "*",
    "@3pino/ui-kit-web": "git+https://github.com/3pino/ui-kit-web.git#v0.3.5",
    "@3pino/viewer-kit-web": "git+https://github.com/3pino/viewer-kit-web.git#v0.1.0",
    "@lucide/svelte": "^1.53.0",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
